# Copy to .env for local dev. In production (Railway), set these as service variables instead.
#
# IMPORTANT: do NOT set NODE_ENV here. Next.js sets it automatically (development for `next dev`,
# production for `next build`/`next start`); pinning it in .env breaks the production build. Railway
# sets NODE_ENV=production for you.

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Local: the docker:dev Postgres. Prod: Railway Postgres plugin's DATABASE_URL.
DATABASE_URL="postgresql://labprice:labprice@localhost:5432/labprice?schema=public"

# ── Redis (BullMQ queues; admin "Scrape now" + the worker) ───────────────────
# Local: docker:dev Redis. Prod: Railway Redis plugin's REDIS_URL.
REDIS_URL="redis://localhost:6379"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32`. MUST be a strong random value in prod.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL: the canonical site URL. Prod: https://labtestcompare.com
AUTH_URL="http://localhost:3000"
# Behind a proxy (Cloudflare → Railway), NextAuth needs this to trust the forwarded host. Set in prod.
AUTH_TRUST_HOST="true"

# Google OAuth — required for Google login in prod (empty = button does nothing).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend) — required for magic-link login + admin alert emails in prod.
# Without it, the /auth/signin email button no-ops. (Dev uses the on-page Dev sign-in instead.)
RESEND_API_KEY=""
EMAIL_FROM="LabTestCompare <noreply@labtestcompare.com>"

# ── Anthropic (optional) ─────────────────────────────────────────────────────
# Enables admin Add Test "✨ Auto-fill" copy generation. Without it, auto-fill still returns
# Quest/LabCorp codes from vendor catalogs, just no generated prose.
ANTHROPIC_API_KEY=""

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical public URL — used for sitemap, robots, canonical/OG tags, JSON-LD, and the OG image base.
NEXT_PUBLIC_BASE_URL="https://labtestcompare.com"

# Optional: GA4 measurement id (e.g. "G-XXXXXXXXXX") — leave empty to skip Google Analytics entirely
# (GoogleAnalytics.tsx renders nothing without it). Never fires on /admin/* pages either way.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: GA4 Data API — pulls sessions/geo/device/funnel-event data into /admin/analytics
# (see lib/ga4-data.ts). This is separate from NEXT_PUBLIC_GA_MEASUREMENT_ID above (that's the
# client-side tracking tag; this is a read-only server credential for pulling reports back out).
# Needs a GCP service account granted "Viewer" on the GA4 property (Admin -> Property Access
# Management). Leave any of these three empty to skip — the admin page just omits this section.
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
