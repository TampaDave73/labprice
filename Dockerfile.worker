# Worker image — the scrape worker service on Railway builds THIS file instead of ./Dockerfile
# (set per-service via the RAILWAY_DOCKERFILE_PATH variable). It exists because Railway cannot
# target a stage of a multi-stage Dockerfile; the main Dockerfile's final stage is the web app.
# No `pnpm build` on purpose: the worker runs its TypeScript straight through tsx (same as dev),
# so it only needs deps + the Prisma client + Playwright's browser.
#
# Debian (bookworm-slim), NOT alpine like the web image: browser-gated vendors (Request A Test,
# True Health Labs) scrape through headless Chromium, and Playwright's browser builds are
# glibc-only — they cannot run on musl/alpine at all.

# Stage 1: base
FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Stage 2: deps
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/scrapers/package.json ./packages/scrapers/package.json
RUN pnpm install --frozen-lockfile

# Stage 3: worker
FROM base AS worker
ENV NODE_ENV=production
COPY --from=deps /app/ ./
COPY . .
RUN pnpm --filter @labprice/database exec prisma generate
# Chromium (+ headless shell) and its OS libraries for the stealth browser fetch. Runs as root, so
# browsers land in /root/.cache/ms-playwright — the same path Playwright resolves at runtime.
RUN pnpm --filter @labprice/scrapers exec playwright install --with-deps chromium
# Health server binds $PORT when Railway injects one (falls back to 3001 locally).
EXPOSE 3001
# Run from the worker package so `pnpm exec` finds its package-local tsx bin — pnpm does NOT hoist
# workspace binaries to the root node_modules/.bin (same pattern as the web stage's `pnpm exec next`).
WORKDIR /app/apps/worker
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
