// LabPrice — Prisma schema (PostgreSQL 16)
// Deliverable #2. This is the authoritative data model; ddl.sql adds
// partitioning, generated columns (search_vector), CHECK constraints,
// and citext extensions that Prisma cannot express directly.
//
// Conventions: CUID2 string PKs (@default(cuid())); created_at/updated_at
// on every model; deleted_at on mutable domain tables; NUMERIC(10,2) money
// via Decimal; native Postgres enums; snake_case via @map.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  // Explicit engine targets for the two deploy images: the worker (node:22-bookworm-slim) has no
  // `openssl` binary, so Prisma's "native" detection silently falls back to debian-openssl-1.1.x
  // and the client crashes at runtime on the actual 3.0.x system. The web image is alpine (musl).
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum CodeType {
  QUEST
  LABCORP
}

enum TrustLevel {
  LOW
  MEDIUM
  HIGH
}

enum PriceSource {
  SCRAPE
  MANUAL
  IMPORT
}

enum ScrapeEngine {
  PLAYWRIGHT
  SELENIUM
  HTTP
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
}

enum ResultStatus {
  MATCHED
  UNMATCHED
  PRICE_CHANGED
  PRICE_SAME
  ERROR
}

enum ScrapeErrorType {
  NAV_TIMEOUT
  BLOCKED
  SELECTOR_MISS
  PARSE_FAIL
  HTTP_ERROR
  ANOMALY
  OTHER
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum JobTrigger {
  SCHEDULE
  MANUAL
  RETRY
}

enum ProxyType {
  DATACENTER
  RESIDENTIAL
}

enum SuggestionStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// ───────────────────────── Identity / Auth.js ─────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique // citext in ddl.sql
  name            String?
  role            Role      @default(USER)
  // MUST be named `emailVerified` (not `emailVerifiedAt`): the Auth.js Prisma adapter writes this
  // exact field on the magic-link callback (updateUser). The DB column stays `email_verified_at`.
  emailVerified   DateTime? @map("email_verified_at")
  image           String?
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  affiliateClicks AffiliateClick[]
  auditLogs       AuditLog[]
  searchLogs      SearchLog[]
  pageViews       PageView[]
  reviewedChanges StagedPriceChange[] @relation("ChangeReviewer")
  systemSettings  SystemSetting[]     @relation("SettingUpdater")
  vendorSuggestions VendorSuggestion[]
  testSuggestions   TestSuggestion[]
  resultErrorReports ResultErrorReport[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  colorBg      String?  @map("color_bg")
  colorText    String?  @map("color_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tests          Test[]
  testCategories TestCategory[]
  seoPages       SeoPage[]

  @@index([displayOrder])
  @@map("categories")
}

model Test {
  id           String    @id @default(cuid())
  name         String
  shortName    String    @map("short_name")
  slug         String    @unique
  categoryId   String    @map("category_id")
  description  String?
  purpose      String?
  procedure    String?
  preparation  String?
  normalRange  String?   @map("normal_range")
  questCode    String?   @map("quest_code")
  labcorpCode  String?   @map("labcorp_code")
  isPopular    Boolean   @default(false) @map("is_popular")
  displayOrder Int       @default(0) @map("display_order")
  // search_vector tsvector is a GENERATED ALWAYS column in ddl.sql; Prisma cannot model it.
  // GIN index on search_vector is also defined in ddl.sql.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // `categoryId` is the PRIMARY category (drives URL, breadcrumb, card badge).
  // `categories` are ADDITIONAL categories a test also belongs to (many-to-many).
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categories    TestCategory[]
  codes         TestCode[]
  aliases       TestAlias[]
  biomarkers    TestBiomarker[]
  offerings     Offering[]
  vendorProducts          VendorProduct[] @relation("VendorProductTest")
  suggestedVendorProducts VendorProduct[] @relation("VendorProductSuggestion")
  scrapeResults ScrapeResult[]
  pageViews     PageView[]
  seoPages      SeoPage[]
  errorReports  ResultErrorReport[]

  @@index([categoryId])
  @@index([isPopular])
  @@index([displayOrder])
  @@map("tests")
}

model TestCode {
  id        String   @id @default(cuid())
  testId    String   @map("test_id")
  codeType  CodeType @map("code_type")
  codeValue String   @map("code_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, codeType])
  @@index([codeType, codeValue])
  @@map("test_codes")
}

model Biomarker {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  unit        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tests TestBiomarker[]

  @@map("biomarkers")
}

model TestBiomarker {
  testId      String   @map("test_id")
  biomarkerId String   @map("biomarker_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  biomarker Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  @@id([testId, biomarkerId])
  @@index([biomarkerId])
  @@map("test_biomarkers")
}

/// Alternate names for a test, learned from confirmed vendor matches (each vendor names the same
/// test differently) or edited via the tests CSV. `normalized` (lowercased, punctuation-stripped)
/// is the matching key: an exact normalized-alias hit is strong enough to AUTO-link a vendor
/// product; anything fuzzier only ever produces a review suggestion.
model TestAlias {
  id         String   @id @default(cuid())
  testId     String   @map("test_id")
  alias      String
  normalized String
  /// Where this alias came from: a vendor slug (learned on confirm), 'csv', or 'manual'.
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, normalized])
  @@index([normalized])
  @@map("test_aliases")
}

/// Many-to-many: additional categories a test belongs to (beyond its primary `Test.categoryId`).
model TestCategory {
  testId     String   @map("test_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([testId, categoryId])
  @@index([categoryId])
  @@map("test_categories")
}

// ───────────────────────── Vendors & Offerings ─────────────────────────

model Vendor {
  id                   String     @id @default(cuid())
  name                 String     @unique
  slug                 String     @unique
  websiteUrl           String?    @map("website_url")
  affiliateUrlTemplate String?    @map("affiliate_url_template")
  logoUrl              String?    @map("logo_url")
  // Short note about this vendor's membership program shown next to member prices, e.g. "$9/mo membership".
  membershipNote       String?    @map("membership_note")
  isActive             Boolean    @default(true) @map("is_active")
  trustLevel           TrustLevel @default(MEDIUM) @map("trust_level")
  // Manual pin for trust. When null, effective trust = auto-computed from scraper health.
  trustOverride        TrustLevel? @map("trust_override")
  deletedAt            DateTime?  @map("deleted_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  offerings      Offering[]
  scrapeConfig   ScrapeVendorConfig?
  scrapeJobs     ScrapeJob[]
  scrapeRuns     ScrapeRun[]
  vendorProducts VendorProduct[]

  @@index([isActive])
  @@map("vendors")
}

model Offering {
  id             String    @id @default(cuid())
  testId         String    @map("test_id")
  vendorId       String    @map("vendor_id")
  currentPrice   Decimal?  @map("current_price") @db.Decimal(10, 2)
  previousPrice  Decimal?  @map("previous_price") @db.Decimal(10, 2)
  // Optional discounted price for members of a vendor's membership program (e.g. MitoHealth $9/mo).
  // `currentPrice` stays the non-member price so cross-vendor ranking is apples-to-apples; the member
  // price is shown as a secondary inline note. See Vendor.membershipNote for the membership terms.
  memberPrice    Decimal?  @map("member_price") @db.Decimal(10, 2)
  // Which lab fulfills currentPrice ('quest' | 'labcorp' | null) — only meaningfully populated for
  // vendors matched via mergeCodeTiers (Dirt Cheap Labs sells the same test through both labs at
  // different prices). altLabPrice/altLabProvider hold the OTHER lab's price when both exist, so it
  // can be shown as a secondary option instead of silently discarded (currentPrice/labProvider stay
  // the cheaper lab — unchanged ranking behavior). See packages/scrapers catalog/matcher.ts.
  labProvider    String?   @map("lab_provider")
  altLabPrice    Decimal?  @map("alt_lab_price") @db.Decimal(10, 2)
  altLabProvider String?   @map("alt_lab_provider")
  // Stable per-lab prices for mergeCodeTiers vendors (currently only Dirt Cheap Labs) — populated
  // independently of which lab is cheaper. currentPrice/labProvider/altLabPrice/altLabProvider above
  // remain a DERIVED cheaper/pricier ranking, recomputed from these two whenever either publishes
  // (see rankDualLabPrices in packages/scrapers/src/catalog/dual-lab-pricing.ts) — every other reader
  // of Offering (public site, sitemap, CSV export/import, trends) needs no changes. Null for every
  // non-dual-lab vendor.
  questPrice           Decimal? @map("quest_price") @db.Decimal(10, 2)
  questPreviousPrice   Decimal? @map("quest_previous_price") @db.Decimal(10, 2)
  labcorpPrice         Decimal? @map("labcorp_price") @db.Decimal(10, 2)
  labcorpPreviousPrice Decimal? @map("labcorp_previous_price") @db.Decimal(10, 2)
  priceUpdatedAt DateTime? @map("price_updated_at")
  // When a scraper last VERIFIED this price (changed or unchanged). priceUpdatedAt only moves on a
  // price change, so the site's "checked N ago" freshness reads this — not priceUpdatedAt.
  lastCheckedAt  DateTime? @map("last_checked_at")
  externalUrl    String?   @map("external_url")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  test               Test                @relation(fields: [testId], references: [id], onDelete: Restrict)
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  priceHistory       PriceHistory[]
  stagedPriceChanges StagedPriceChange[]
  scrapeResults      ScrapeResult[]
  affiliateClicks    AffiliateClick[]
  errorReports       ResultErrorReport[]

  @@unique([testId, vendorId])
  @@index([testId])
  @@index([vendorId])
  @@index([priceUpdatedAt])
  @@map("offerings")
}

enum VendorProductStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/// The RAW ingest layer: every product every catalog crawl finds, kept forever (nothing discarded).
/// Canonical Tests/Offerings are curated ON TOP of this — a product only feeds public prices once
/// it's MATCHED to a Test (auto on exact code/alias, or by admin review at /admin/discovered).
/// Page-based vendors' narrow crawls only fetch detail pages for name-candidates, so many rows are
/// name+URL only (price/codes null) until a fuller crawl or a match brings detail in.
model VendorProduct {
  id             String              @id @default(cuid())
  vendorId       String              @map("vendor_id")
  /// Adapter slug — the stable per-vendor product key the crawlers already dedupe on.
  slug           String
  name           String
  /// Lowercased/punctuation-stripped name — the grouping + exact-alias matching key.
  normalizedName String              @map("normalized_name")
  url            String?
  /// Cheapest non-panel provider price observed on the last crawl that fetched detail.
  price          Decimal?            @db.Decimal(10, 2)
  labProvider    String?             @map("lab_provider")
  questCode      String?             @map("quest_code")
  labcorpCode    String?             @map("labcorp_code")
  /// Vendor-flagged bundle, or (detail not fetched) name-heuristic. Panels are excluded from
  /// matching/clustering by product decision 2026-07-20 — no two vendors sell the same panel.
  isPanel        Boolean             @default(false) @map("is_panel")
  status         VendorProductStatus @default(UNMATCHED)
  /// Set when MATCHED. Matching a product does NOT create the offering by itself — listing is a
  /// separate deliberate step (review UI), so nothing unreviewed reaches public prices.
  testId         String?             @map("test_id")
  /// 'quest-code' | 'labcorp-code' | 'exact-name' | 'alias' | 'offering' | 'manual'
  matchedBy      String?             @map("matched_by")
  /// Fuzzy candidate (token-overlap) — a suggestion for review, never auto-applied (strict mode).
  suggestedTestId String?            @map("suggested_test_id")
  firstSeenAt    DateTime            @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime            @default(now()) @map("last_seen_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  vendor        Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  test          Test?  @relation("VendorProductTest", fields: [testId], references: [id], onDelete: SetNull)
  suggestedTest Test?  @relation("VendorProductSuggestion", fields: [suggestedTestId], references: [id], onDelete: SetNull)

  @@unique([vendorId, slug])
  @@index([status, isPanel])
  @@index([normalizedName])
  @@index([questCode])
  @@index([labcorpCode])
  @@index([testId])
  @@map("vendor_products")
}

/// Append-only, partitioned by RANGE(observed_at) monthly — see ddl.sql.
/// PK is (id, observed_at) composite in ddl.sql for partition support.
model PriceHistory {
  id          BigInt      @id @default(autoincrement())
  offeringId  String      @map("offering_id")
  oldPrice    Decimal?    @map("old_price") @db.Decimal(10, 2)
  newPrice    Decimal     @map("new_price") @db.Decimal(10, 2)
  observedAt  DateTime    @map("observed_at")
  source      PriceSource
  scrapeRunId String?     @map("scrape_run_id")
  // Mirrors StagedPriceChange.labProvider — which lab this observation is for, when applicable. Null
  // for every ordinary single-price vendor.
  labProvider String?     @map("lab_provider")
  createdAt   DateTime    @default(now()) @map("created_at")

  offering  Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  scrapeRun ScrapeRun? @relation(fields: [scrapeRunId], references: [id], onDelete: SetNull)

  @@index([offeringId, observedAt(sort: Desc)])
  @@index([source])
  @@map("price_history")
}

// ───────────────────────── Scraping Infrastructure ─────────────────────────

model ScrapeVendorConfig {
  id           String       @id @default(cuid())
  vendorId     String       @unique @map("vendor_id")
  engine       ScrapeEngine
  baseUrl      String?      @map("base_url")
  selectors    Json         @default("{}")
  authConfig   Json?        @map("auth_config")
  // How often the daily scheduler tick scrapes this vendor. 0 = manual only ("Scrape now").
  frequencyDays Int         @default(7) @map("frequency_days")
  isEnabled    Boolean      @default(true) @map("is_enabled")
  maxRetries   Int          @default(3) @map("max_retries")
  timeoutMs    Int          @default(30000) @map("timeout_ms")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@map("scrape_vendor_configs")
}

model ScrapeJob {
  id           String     @id @default(cuid())
  vendorId     String?    @map("vendor_id")
  triggeredBy  JobTrigger @map("triggered_by")
  status       JobStatus  @default(PENDING)
  scheduledAt  DateTime?  @map("scheduled_at")
  startedAt    DateTime?  @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  errorMessage String?    @map("error_message")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  vendor Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  runs   ScrapeRun[]

  @@index([vendorId, createdAt(sort: Desc)])
  @@index([status])
  @@map("scrape_jobs")
}

model ScrapeRun {
  id              String    @id @default(cuid())
  jobId           String    @map("job_id")
  vendorId        String    @map("vendor_id")
  status          RunStatus @default(QUEUED)
  testsFound      Int?      @map("tests_found")
  pricesUpdated   Int?      @map("prices_updated")
  pricesUnchanged Int?      @map("prices_unchanged")
  errorsCount     Int?      @map("errors_count")
  durationMs      Int?      @map("duration_ms")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  job          ScrapeJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vendor       Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  results      ScrapeResult[]
  errors       ScrapeError[]
  priceHistory PriceHistory[]
  stagedChanges StagedPriceChange[]

  @@index([vendorId, startedAt(sort: Desc)])
  @@index([jobId])
  @@index([status])
  @@map("scrape_runs")
}

model ScrapeResult {
  id                String       @id @default(cuid())
  runId             String       @map("run_id")
  testId            String       @map("test_id")
  scrapedPrice      Decimal?     @map("scraped_price") @db.Decimal(10, 2)
  matchedOfferingId String?      @map("matched_offering_id")
  status            ResultStatus
  rawHtml           String?      @map("raw_html")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  run      ScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  test     Test      @relation(fields: [testId], references: [id], onDelete: Restrict)
  offering Offering? @relation(fields: [matchedOfferingId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([matchedOfferingId])
  @@index([testId])
  @@map("scrape_results")
}

model ScrapeError {
  id             String         @id @default(cuid())
  runId          String         @map("run_id")
  errorType      ScrapeErrorType @map("error_type")
  message        String
  stackTrace     String?        @map("stack_trace")
  url            String?
  screenshotPath String?        @map("screenshot_path")
  createdAt      DateTime       @default(now()) @map("created_at")

  run ScrapeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([errorType])
  @@map("scrape_errors")
}

model StagedPriceChange {
  id           String       @id @default(cuid())
  offeringId   String       @map("offering_id")
  oldPrice     Decimal?     @map("old_price") @db.Decimal(10, 2)
  newPrice     Decimal      @map("new_price") @db.Decimal(10, 2)
  scrapedAt    DateTime     @map("scraped_at")
  scrapeRunId  String       @map("scrape_run_id")
  status       ChangeStatus @default(PENDING)
  reviewedById String?      @map("reviewed_by")
  reviewedAt   DateTime?    @map("reviewed_at")
  reviewNote   String?      @map("review_note")
  // Which lab this staged change is for, when the offering is priced through multiple labs
  // (mergeCodeTiers vendors, e.g. Dirt Cheap Labs). Null for every ordinary single-price vendor —
  // unchanged behavior.
  labProvider  String?      @map("lab_provider")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  offering   Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  scrapeRun  ScrapeRun @relation(fields: [scrapeRunId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([offeringId])
  @@index([scrapeRunId])
  @@map("staged_price_changes")
}

model Proxy {
  id           String    @id @default(cuid())
  url          String
  provider     String?
  type         ProxyType
  isActive     Boolean   @default(true) @map("is_active")
  successCount Int       @default(0) @map("success_count")
  failCount    Int       @default(0) @map("fail_count")
  lastUsedAt   DateTime? @map("last_used_at")
  lastFailedAt DateTime? @map("last_failed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isActive, lastUsedAt])
  @@index([type])
  @@map("proxies")
}

// ───────────────────────── Engagement ─────────────────────────
// SavedTest/Notification/PriceAlert/AlertNotification (Save / Price-Alert / dashboard features)
// were removed 2026-07-06 and the tables dropped 2026-07-21 (see docs/database/*.sql) — the
// feature stayed off long enough with near-zero data that keeping the dormant tables around
// stopped being worth the schema noise.

/// Partitioned by RANGE(clicked_at) monthly — see ddl.sql.
/// Uses BIGSERIAL PK for high-volume storage efficiency.
model AffiliateClick {
  id          BigInt   @id @default(autoincrement())
  offeringId  String   @map("offering_id")
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  ipHash      String?  @map("ip_hash")
  userAgentHash String? @map("user_agent_hash")
  referrer    String?
  clickedAt   DateTime @default(now()) @map("clicked_at")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clickedAt])
  @@index([offeringId, clickedAt])
  @@index([userId])
  @@map("affiliate_clicks")
}

// ───────────────────────── Analytics & Operations ─────────────────────────

/// Partitioned by RANGE(created_at) monthly — see ddl.sql.
model SearchLog {
  id           BigInt   @id @default(autoincrement())
  query        String
  resultsCount Int      @map("results_count")
  userId       String?  @map("user_id")
  sessionId    String?  @map("session_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("search_logs")
}

/// Partitioned by RANGE(created_at) monthly — see ddl.sql.
model PageView {
  id        BigInt   @id @default(autoincrement())
  path      String
  testId    String?  @map("test_id")
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  test Test? @relation(fields: [testId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([testId, createdAt])
  @@index([path])
  @@map("page_views")
}

model SeoPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaDescription String?  @map("meta_description")
  heading         String?
  bodyHtml        String?  @map("body_html")
  testId          String?  @map("test_id")
  categoryId      String?  @map("category_id")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  test     Test?     @relation(fields: [testId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([testId])
  @@index([categoryId])
  @@index([isPublished])
  @@map("seo_pages")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── User-submitted suggestions ─────────────────────────
// Public "Suggest a Vendor" / "Suggest a Test" forms (site footer). Reviewed by admins in
// /admin/suggestions; not auto-applied to the catalog.

model VendorSuggestion {
  id         String           @id @default(cuid())
  vendorName String           @map("vendor_name")
  vendorUrl  String?          @map("vendor_url")
  note       String?
  email      String?
  status     SuggestionStatus @default(PENDING)
  userId     String?          @map("user_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("vendor_suggestions")
}

model TestSuggestion {
  id        String           @id @default(cuid())
  testName  String           @map("test_name")
  note      String?
  email     String?
  status    SuggestionStatus @default(PENDING)
  userId    String?          @map("user_id")
  createdAt DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("test_suggestions")
}

/// Visitor-reported problem with a test page's listed results ("price is wrong", "dead order link",
/// "wrong code"). Reviewed alongside vendor/test suggestions at /admin/suggestions — purely a triage
/// queue; nothing here mutates prices or offerings.
model ResultErrorReport {
  id         String           @id @default(cuid())
  testId     String           @map("test_id")
  offeringId String?          @map("offering_id") // optionally pinpoints which vendor row is wrong
  message    String
  email      String?
  status     SuggestionStatus @default(PENDING)
  userId     String?          @map("user_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  test     Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([testId])
  @@map("result_error_reports")
}
